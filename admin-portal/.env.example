# ใช้ Supabase โปรเจกต์เดียวกับเว็บผู้ใช้
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# ต้องไม่ซ้ำกับเว็บผู้ใช้ เพื่อแยก session ของผู้ดูแลออกจากกัน
NEXT_PUBLIC_SUPABASE_COOKIE_NAME=rice-ai-admin-auth

# ใช้เฉพาะ Route Handler ฝั่ง server สำหรับอัปโหลดสื่อและจัดการบทบาทผู้ใช้
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key

# URL ของเว็บไซต์ผู้ใช้จริง เมื่อ deploy
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000

# ไม่จำเป็นสำหรับ CRUD ราคาเอง แต่ต้องมีเมื่อใช้ปุ่มดึงราคาข้าวจาก Agri-Map
THAGRI_API_TOKEN=
THAGRI_RICE_LAT=14.8818
THAGRI_RICE_LON=102.0207
