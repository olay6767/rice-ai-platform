NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_COOKIE_NAME=rice-ai-user-auth
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์สำหรับอัปโหลดรูปและจัดการบทบาทผู้ใช้ในหน้า /admin
# ห้ามใส่ NEXT_PUBLIC_ และห้าม commit ค่า key จริง
SUPABASE_SERVICE_ROLE_KEY=
# อีเมล Admin เดิมที่ใช้ bootstrap เป็น Super Admin คั่นหลายบัญชีด้วย comma
# ต้องตั้งเฉพาะฝั่ง server และบัญชีควรมี app_metadata.role=admin อยู่แล้ว
SUPER_ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3001

# สร้างคีย์ที่ https://aistudio.google.com/api-keys
# ห้ามใช้ NEXT_PUBLIC_ นำหน้า เพราะคีย์ต้องอยู่ฝั่งเซิร์ฟเวอร์เท่านั้น
GEMINI_API_KEY=

# ค่าเริ่มต้นที่สมดุลคุณภาพและค่าใช้จ่าย เปลี่ยนได้โดยไม่ต้องแก้โค้ด
GEMINI_MODEL=gemini-3.6-flash

# ไม่ใส่ก็ได้ ระบบการเงินจะใช้ GEMINI_MODEL ด้านบน
GEMINI_FINANCE_MODEL=gemini-3.6-flash

# URL ภายในของ FastAPI service สำหรับโมเดลตรวจโรคข้าว
# ห้ามใช้ NEXT_PUBLIC_ เพราะต้องเรียกผ่าน Next.js API route เท่านั้น
DISEASE_API_URL=http://127.0.0.1:8000
DISEASE_MODEL_VERSION=set2-resnet50-finetuned

# ราคาข้าวจาก Agri-Map / THAGRI: สร้าง token จาก https://thagri.in.th
# ข้อมูลจาก API อิงพิกัด จึงกำหนดพิกัดพื้นที่อ้างอิงที่ต้องการใช้
# ห้ามใส่ NEXT_PUBLIC_ นำหน้าตัวแปรเหล่านี้
THAGRI_API_TOKEN=
THAGRI_RICE_LAT=
THAGRI_RICE_LON=
