# อนุญาตเฉพาะกรณีที่ต้องเรียก FastAPI โดยตรงจาก browser
# Next.js จะเรียกจากฝั่ง server จึงไม่จำเป็นต้องกำหนดค่านี้
FRONTEND_ORIGINS=http://localhost:3000

VALIDATOR_MODEL_PATH=models/Binary_Set2_ResNet50_best.keras
CLASSIFIER_MODEL_PATH=models/Set2_ResNet50_Finetuned_best.keras
# ถ้าไม่มีไฟล์โมเดลในเครื่อง บริการจะดึงจาก private Vercel Blob เมื่อวิเคราะห์ภาพครั้งแรก
VALIDATOR_MODEL_URL=
CLASSIFIER_MODEL_URL=
BLOB_READ_WRITE_TOKEN=
RICE_THRESHOLD=0.90
DISEASE_THRESHOLD=0.80

# ต้องยืนยันกับ notebook ตอนเทรนก่อนนำขึ้น production
# ตัวเลือก: raw, rescale_01, resnet50
PREPROCESS_MODE=raw

# Set the same server-only secret on the disease API and Next.js in production.
DISEASE_API_TOKEN=
